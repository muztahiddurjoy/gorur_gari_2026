<?xml version="1.0"?>
<!--
  RPLIDAR C1, where the CAD puts it: hanging upside down under the third deck,
  76 mm ahead of base_link, with its scan plane 68.25 mm off the ground (through
  the optical window of the housing). That clears the bumper (52.5 mm) and the
  wheels (53 mm) in front, and cuts through the standoffs and the Pi's connectors
  behind: the real scanner sees those too, so the meshes are left in the beam.

  bot.lidar.forward_offset_m in bot_config.yaml says 0.0 and open_round_run treats
  the scanner as the car's centre. The simulator does not correct for that: it
  mounts the sensor where the car has it, so the stack sees what it sees on the car.

  The numbers match what rplidar_ros publishes on the real car:

    angle_compensate true   720 rays: points_per_circle = 1e6 / 200 us / 10 Hz = 500,
                            multiple = int(500 / 360 + 1) = 2, count = 360 * 2
    angles                  -179 .. +180 deg (publish_scan: pi - 359 deg .. pi)
    scan rate               10 Hz, C1 typical
    range                   0.05 .. 12 m, datasheet (white target)
    accuracy                +-30 mm, gaussian stddev 10 mm; resolution 15 mm

  The sensor frame is modelled upright. The driver's `inverted` flag on the real
  car exists to undo the upside down mount, so the published scan is already
  REP-103 counter-clockwise, and that published scan is what is modelled here.

  frame_id stays `laser`: bot.lidar.frame_id.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="goruBot">

    <joint name="base_to_laser" type="fixed">
        <parent link="base_link" />
        <child link="laser" />
        <origin xyz="${laser_xyz}" />
    </joint>

    <link name="laser">
        <xacro:laser_cad />
        <collision>
            <origin xyz="0 0 ${lidar_body_center_z}" />
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_body_length}" />
            </geometry>
        </collision>
    </link>

    <gazebo reference="laser">
        <!-- Keep `laser` a real link in the converted SDF, so the sensor frame and
             the TF frame carry the same name. -->
        <disableFixedJointLumping>true</disableFixedJointLumping>

        <sensor name="lidar" type="gpu_lidar">
            <topic>scan</topic>
            <ignition_frame_id>laser</ignition_frame_id>
            <update_rate>10</update_rate>
            <always_on>1</always_on>
            <visualize>true</visualize>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>720</samples>
                        <resolution>1</resolution>
                        <min_angle>${radians(-179.0)}</min_angle>
                        <max_angle>${pi}</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.05</min>
                    <max>12.0</max>
                    <resolution>0.015</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>
</robot>

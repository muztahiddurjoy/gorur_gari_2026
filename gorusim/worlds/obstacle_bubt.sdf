<?xml version="1.0" ?>
<!--
  BUBT FastRobox / Autonomous Navigation Challenge 2026: Obstacle Avoidance Round.
  A straight 3.0m x 1.0m corridor enclosed by 10cm black walls.
  Finish line is marked at x = 2.70m, exactly 30cm before the x = 3.00m end boundary wall.
-->
<sdf version="1.8">
  <world name="obstacle_bubt">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ══ Systems ═══════════════════════════════════════════════════ -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact" />
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu" />

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.85 0.85 0.85 1</ambient>
      <background>0.75 0.80 0.87 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Overhead directional light -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>1.5 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.1 0.1 -0.95</direction>
    </light>

    <!-- ══ Floor ═════════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <pose>1.5 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>6 6</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <laser_retro>120</laser_retro>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>6 6</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.30 0.30 0.32 1</ambient>
            <diffuse>0.35 0.35 0.37 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual Track Surface & Markings -->
    <model name="track_surface">
      <static>true</static>
      <link name="link">
        <!-- Main corridor floor (3.0m x 1.0m) -->
        <visual name="floor">
          <pose>1.5 0 0.0005 0 0 0</pose>
          <geometry><box><size>3.0 1.0 0.001</size></box></geometry>
          <material>
            <ambient>0.60 0.60 0.62 1</ambient>
            <diffuse>0.65 0.65 0.67 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>

        <!-- Start line marking at x = 0.30m -->
        <visual name="start_line">
          <pose>0.30 0 0.001 0 0 0</pose>
          <geometry><box><size>0.02 1.0 0.001</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>

        <!-- Finish line marking at x = 2.70m (30cm before the end wall) -->
        <visual name="finish_line">
          <pose>2.70 0 0.001 0 0 0</pose>
          <geometry><box><size>0.05 1.0 0.001</size></box></geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.95 0.1 0.1 1</diffuse>
          </material>
        </visual>

        <!-- Finish run-out area between x = 2.70m and 3.00m -->
        <visual name="finish_runout">
          <pose>2.85 0 0.0008 0 0 0</pose>
          <geometry><box><size>0.30 1.0 0.001</size></box></geometry>
          <material>
            <ambient>0.50 0.50 0.52 1</ambient>
            <diffuse>0.55 0.55 0.57 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══ Boundary Walls (10 cm high, black, laser_retro 220) ══════ -->
    <model name="wall_start">
      <static>true</static>
      <pose>-0.015 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.03 1.06 0.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <laser_retro>220</laser_retro>
          <geometry><box><size>0.03 1.06 0.10</size></box></geometry>
          <material>
            <ambient>0.10 0.10 0.10 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_end">
      <static>true</static>
      <pose>3.015 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.03 1.06 0.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <laser_retro>220</laser_retro>
          <geometry><box><size>0.03 1.06 0.10</size></box></geometry>
          <material>
            <ambient>0.10 0.10 0.10 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_left">
      <static>true</static>
      <pose>1.5 0.515 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.06 0.03 0.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <laser_retro>220</laser_retro>
          <geometry><box><size>3.06 0.03 0.10</size></box></geometry>
          <material>
            <ambient>0.10 0.10 0.10 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_right">
      <static>true</static>
      <pose>1.5 -0.515 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.06 0.03 0.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <laser_retro>220</laser_retro>
          <geometry><box><size>3.06 0.03 0.10</size></box></geometry>
          <material>
            <ambient>0.10 0.10 0.10 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

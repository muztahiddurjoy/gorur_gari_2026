<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lazysim</name>
  <version>1.0.0</version>
  <description>
    Ignition Gazebo Fortress simulation of the Gorur Gari 2026 WRO Future
    Engineers car. Presents the same ROS interface as the real vehicle so
    the controls and autonomy packages run against it unchanged.

    Adapted from Team LazyGo's simulator:
    https://github.com/A-N-M-Noor/LazyGo_WRO2025/
    For testing and development purposes only; not part of the competition
    vehicle or its run.
  </description>
  <maintainer email="muztahid.appbaksho@gmail.com">Team Gorur Gari</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- track_maker builds the layout through `ign service`, which ships
       with ignition-tools as part of Fortress. -->
  <exec_depend>python3-yaml</exec_depend>

  <!-- The nodes the sim exists to exercise. -->
  <exec_depend>controls</exec_depend>
  <exec_depend>autonomy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

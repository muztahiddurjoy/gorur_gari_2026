Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /LaserScan1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 14
      Color: 100; 100; 100
      Alpha: 0.4
      Line Style:
        Line Width: 0.02
        Value: Lines
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Alpha: 1
      TF Prefix: ""
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.25
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Frame Timeout: 15
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Alpha: 1
      Size (m): 0.02
      Style: Spheres
      Color: 255; 90; 90
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Queue Size: 10
    - Class: rviz_default_plugins/LaserScan
      Name: ProcessedScan
      Enabled: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /open_round/scan_processed
      Alpha: 0.6
      Size (m): 0.02
      Style: Spheres
      Color: 90; 200; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Queue Size: 10
    - Class: rviz_default_plugins/Odometry
      Name: GroundTruthOdom
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Covariance:
        Value: false
      Keep: 200
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape:
        Alpha: 0.7
        Color: 120; 255; 120
        Head Length: 0.04
        Head Radius: 0.025
        Shaft Length: 0.08
        Shaft Radius: 0.01
        Value: Arrow
    - Class: rviz_default_plugins/Marker
      Name: TargetMarker
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /open_round/target_marker
      Namespaces: {}
    - Class: rviz_default_plugins/Marker
      Name: DisparityTargetMarker
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /disparity/target_marker
      Namespaces: {}
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/image_raw
      Max Value: 1
      Min Value: 0
      Normalize Range: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 4.5
      Focal Point:
        X: 0
        Y: 1
        Z: 0
      Pitch: 1.0
      Yaw: 4.7
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: ""

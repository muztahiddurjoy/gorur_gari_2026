<?xml version="1.0" ?>
<!--
  ════════════════════════════════════════════════════════════════════
  WRO Future Engineers mat, for Ignition Gazebo Fortress.

  Ported from the Gazebo Classic lazyWorld.world. The geometry is
  unchanged (it was already right); what changed is the plumbing:
  libgazebo_ros_* plugins are gone, replaced by Ignition systems, and
  the Ogre .material scripts are replaced by inline colours.

  Field layout — everything is centred on (0, 1) so the start line sits
  at the origin, which is what config/track.yaml assumes:

      y=2.515  ┌───────────────────────────┐   outer wall
               │                           │
               │        ┌─────────┐        │   inner block
               │        │ 1m x 1m │        │   (x -0.5..0.5,
               │        │         │        │    y  0.5..1.5)
               │        └─────────┘        │
               │                           │
      y=-0.515 └───────────────────────────┘
             x=-1.515                  x=1.515

    playing field   3.00 m x 3.00 m (wall inner faces)
    inner block     1.00 m x 1.00 m
    driving corridor 1.00 m wide
    wall height     0.10 m, thickness 0.03 m

  The car's LiDAR sits 78 mm off the floor, so a 100 mm wall is a solid
  return all the way round — that 22 mm of margin is the real thing too,
  and it is why the lidar mount height in lazyBot.xacro is not a free
  parameter.
  ════════════════════════════════════════════════════════════════════
-->
<sdf version="1.8">
  <world name="lazyWorld">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ══ Systems ═══════════════════════════════════════════════════
         UserCommands is not optional here: it is what serves
         /world/lazyWorld/create and /world/lazyWorld/set_pose, the two
         services track_maker uses to place pillars and the car. -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact" />
    <!-- Renders the gpu_lidar and camera. Without this the car is blind. -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu" />

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.85 0.85 0.85 1</ambient>
      <background>0.75 0.80 0.87 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Bright and near-vertical, with shadows off. The pillar colours
         are what vision_node thresholds in HSV, and a raking light puts
         half of a pillar in shadow and drops its Value below the
         red_lower_1 / green_lower floors in vision_params.yaml. -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 1 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.2 0.2 -0.95</direction>
    </light>

    <!-- ══ Floor ═════════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 1 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4 4</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <laser_retro>120</laser_retro>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3.04 3.04</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.36 1</ambient>
            <diffuse>0.42 0.42 0.44 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══ Walls ═════════════════════════════════════════════════════
         Static, so they never move when the car clips one, and matte
         white like the real mat's board walls. -->
    <model name="wall_outer_south">
      <static>true</static>
      <pose>0 -0.515 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.06 0.03 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <laser_retro>220</laser_retro>
          <geometry><box><size>3.06 0.03 0.1</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_outer_north">
      <static>true</static>
      <pose>0 2.515 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.06 0.03 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <laser_retro>220</laser_retro>
          <geometry><box><size>3.06 0.03 0.1</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_outer_east">
      <static>true</static>
      <pose>1.515 1 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.03 3.03 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <laser_retro>220</laser_retro>
          <geometry><box><size>0.03 3.03 0.1</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_outer_west">
      <static>true</static>
      <pose>-1.515 1 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.03 3.03 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <laser_retro>220</laser_retro>
          <geometry><box><size>0.03 3.03 0.1</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Inner block. On the real mat these four walls move between
         rounds to change the corridor width, which is exactly why
         nothing in the autonomy stack may hard-code a track width. -->
    <model name="wall_inner_south">
      <static>true</static>
      <pose>0 0.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.03 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <laser_retro>220</laser_retro>
          <geometry><box><size>1.0 0.03 0.1</size></box></geometry>
          <material>
            <ambient>0.70 0.70 0.72 1</ambient>
            <diffuse>0.88 0.88 0.90 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_inner_north">
      <static>true</static>
      <pose>0 1.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.03 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <laser_retro>220</laser_retro>
          <geometry><box><size>1.0 0.03 0.1</size></box></geometry>
          <material>
            <ambient>0.70 0.70 0.72 1</ambient>
            <diffuse>0.88 0.88 0.90 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_inner_east">
      <static>true</static>
      <pose>0.5 1 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.03 1.03 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <laser_retro>220</laser_retro>
          <geometry><box><size>0.03 1.03 0.1</size></box></geometry>
          <material>
            <ambient>0.70 0.70 0.72 1</ambient>
            <diffuse>0.88 0.88 0.90 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_inner_west">
      <static>true</static>
      <pose>-0.5 1 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.03 1.03 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <laser_retro>220</laser_retro>
          <geometry><box><size>0.03 1.03 0.1</size></box></geometry>
          <material>
            <ambient>0.70 0.70 0.72 1</ambient>
            <diffuse>0.88 0.88 0.90 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

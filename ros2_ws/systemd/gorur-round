#!/bin/bash
# Show or switch the round gorur-round.service drives on boot.
#
#   gorur-round              print the current round and service state
#   gorur-round open         drive the open round (now and on every boot)
#   gorur-round obstacle     drive the obstacle round (now and on every boot)
set -euo pipefail
CONF=/etc/default/gorur

current() { (grep -E '^GORUR_ROUND=' "$CONF" 2>/dev/null || echo GORUR_ROUND=open) | cut -d= -f2; }

if [ $# -eq 0 ]; then
    echo "round: $(current)"
    systemctl --no-pager --lines=0 status gorur-base.service gorur-round.service || true
    exit 0
fi

case "$1" in
    open|obstacle) ;;
    *) echo "usage: gorur-round [open|obstacle]" >&2; exit 2 ;;
esac

if grep -qE '^GORUR_ROUND=' "$CONF" 2>/dev/null; then
    sudo sed -i "s/^GORUR_ROUND=.*/GORUR_ROUND=$1/" "$CONF"
else
    echo "GORUR_ROUND=$1" | sudo tee -a "$CONF" >/dev/null
fi
sudo systemctl restart gorur-round.service
echo "gorur-round.service now drives the $1 round (persisted in $CONF)"

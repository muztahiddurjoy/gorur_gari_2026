#!/bin/bash
# Show or switch what the start button starts. The choice lives in
# config/round_select.yaml in the workspace; this edits its `round:` line and
# restarts gorur-round.service so it takes effect at once (and on every boot).
#
#   gorur-round              print the round, the start delay and service state
#   gorur-round open         the start button starts the open round
#   gorur-round obstacle     the start button starts the obstacle round
set -euo pipefail
CONF=/etc/default/gorur
WS="$( (grep -E '^GORUR_WS=' "$CONF" 2>/dev/null || echo GORUR_WS=/home/goru/gorur_gari_2026/ros2_ws) | cut -d= -f2-)"
SELECT="$WS/config/round_select.yaml"

# value of a top-level `key: value` line, trailing comment stripped
value() { grep -E "^$1:" "$SELECT" | head -n1 | sed -E "s/^$1:[[:space:]]*//; s/[[:space:]]*#.*$//"; }

if [ ! -f "$SELECT" ]; then
    echo "gorur-round: $SELECT not found (GORUR_WS in $CONF?)" >&2
    exit 1
fi

if [ $# -eq 0 ]; then
    echo "round: $(value round)   start delay: $(value start_delay_sec) s   ($SELECT)"
    systemctl --no-pager --lines=0 status gorur-base.service gorur-round.service || true
    exit 0
fi

case "$1" in
    open|obstacle) ;;
    *) echo "usage: gorur-round [open|obstacle]" >&2; exit 2 ;;
esac

sed -i -E "s/^round:.*/round: $1/" "$SELECT"
sudo systemctl restart gorur-round.service
echo "the start button now starts the $1 round (saved in $SELECT)"
